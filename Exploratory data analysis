---- Exploratory data analysis ;


Select * from Layoff_final;

Select company, SUM(total_laid_off) as total_laid_off
from Layoff_final
group by company, total_laid_off
order by total_laid_off desc;

Select company, SUM(total_laid_off) as total_laid_off
from Layoff_final
group by company, total_laid_off
having company = 'Loft'

EXEC sp_help 'Layoff_final';

With CTE as (
	Select company, total_laid_off,
	rank() over (partition by company order by total_laid_off desc) as row_num
	from Layoff_final
	)
	Select * from CTE
where row_num >3;

