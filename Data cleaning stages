---In Stage 1 ,
---we will clean the data by removing any leading 
---or trailing spaces from the company and location columns, 
---and converting the total_laid_off 
---and percentage_laid_off columns to their appropriate data types.
--Checking duplicate records

Select *, 
	Row_number ()
		over (partition by company,location,industry,total_laid_off 
			Order by company,location,industry,total_laid_off) as Rn_num
from layoffs_stage1;

With duplicates as (
	Select *, 
	Row_number ()
		over (partition by company,location,industry,total_laid_off 
			Order by company,location,industry,total_laid_off) as Rn_num
	from layoffs_stage1
	)
Select * 
from duplicates
where Rn_num >1;

With duplicates as (
	Select *, 
	Row_number ()
		over (partition by company,location,industry,total_laid_off 
			Order by company,location,industry,total_laid_off) as Rn_num
	from layoffs_stage1
	)
Delete
from duplicates
where Rn_num >1;
Select * from layoffs_stage1;  --2291 rows after removing duplicates...


