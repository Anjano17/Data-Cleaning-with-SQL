---In Next process, we will make standardization of the data by checking for any inconsistencies 
---in the industry and stage columns, and standardizing the values to a consistent format. 
---We will also convert the date column to a date data type.

Select company 
from layoffs_stage1

Select company,Trim (company)
from layoffs_stage1
where company like 'E In%'

--Update the company column by removing leading and trailing spaces

Update layoffs_stage1
SET company = Trim(company);

Select Distinct industry
From layoffs_stage1;

Select industry
from layoffs_stage1
where industry like'Crypto%'

Update layoffs_stage1
SET industry = 'Crypto'
Where industry like 'Crypto%';

